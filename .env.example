# Copy to .env and fill in values
# NEVER commit .env to git (it's in .gitignore)

# ================================================================
# MODE
# ================================================================
# Initial mode at startup: collect | paper | live
# Recommended: start with 'collect' and switch via UI.
OPUS_MODE=collect

# Runtime profile: local | vps_live.
# vps_live keeps the server light: no raw data logs, narrow watchlist,
# UI-managed trading settings bounded by hard caps below.
OPUS_RUNTIME_PROFILE=local

# ================================================================
# SERVER
# ================================================================
# Bind address of the HTTP/WS API.
# Keep 127.0.0.1 when you access via SSH tunnel (recommended).
# Use 0.0.0.0 ONLY if the VPS is behind a trusted firewall.
OPUS_HOST=127.0.0.1
OPUS_PORT=8081

# Optional UI basic auth (leave both empty to disable)
OPUS_UI_USER=
OPUS_UI_PASSWORD=

# ================================================================
# STORAGE
# ================================================================
# Base directory for parquet feature snapshots and logs.
OPUS_DATA_DIR=./data
OPUS_LOGS_DIR=./logs

# Parquet file rotation interval (minutes). 60 = one file per hour.
OPUS_PARQUET_ROTATION_MIN=60

# ================================================================
# COLLECTOR
# ================================================================
# How often to record a compact feature snapshot to disk (milliseconds).
OPUS_SNAPSHOT_INTERVAL_MS=250

# Depth of order book levels to keep in memory (top-N each side).
OPUS_LOB_DEPTH=200

# Depth of order book levels to write to each snapshot.
OPUS_SNAPSHOT_DEPTH=40

# Raw tick-level logs (in ADDITION to 250ms snapshots).
#   raw_depth = every depthUpdate event (bids/asks diff).  ~15-20 GB / 10 days / 5 symbols after zstd.
#   raw_trades = every aggTrade event.                     ~10-30 GB / 10 days / 5 symbols after zstd.
# Disable one or both if disk is tight.
OPUS_COLLECT_RAW_DEPTH=false
OPUS_COLLECT_RAW_TRADES=false

# ================================================================
# VPS LIVE PROFILE
# ================================================================
# Recommended on VPS:
# OPUS_RUNTIME_PROFILE=vps_live
# OPUS_HOST=127.0.0.1
# OPUS_PORT=8081
# OPUS_COLLECT_RAW_DEPTH=false
# OPUS_COLLECT_RAW_TRADES=false

# Hard caps. UI settings cannot exceed these values.
OPUS_HARD_DAILY_LOSS_USD=2.0
OPUS_HARD_12H_LOSS_USD=2.0
OPUS_HARD_SYMBOL_LOSS_USD=0.30
OPUS_HARD_MAX_LIVE_SYMBOLS=5
OPUS_HARD_MAX_NOTIONAL_USD=20.0
OPUS_HARD_MAX_LEVERAGE=10

# Telegram status/alerts.
OPUS_TELEGRAM_BOT_TOKEN=
OPUS_TELEGRAM_CHAT_ID=

# ================================================================
# EXCHANGES
# ================================================================
# Binance Futures (USDT-M) endpoints.
# As of 2025 Binance split WS into /public (high-frequency depth), /market
# (regular feeds: aggTrade/markPrice/kline/ticker) and /private (user data).
# We open two separate connections to reduce per-connection load and jitter.
OPUS_BINANCE_WS_PUBLIC=wss://fstream.binance.com/public/stream
OPUS_BINANCE_WS_MARKET=wss://fstream.binance.com/market/stream
# Legacy combined URL — kept for backwards compatibility; not used when
# OPUS_BINANCE_WS_PUBLIC and OPUS_BINANCE_WS_MARKET are set.
OPUS_BINANCE_WS=wss://fstream.binance.com/stream
OPUS_BINANCE_WS_PRIVATE=wss://fstream.binance.com/private/ws
OPUS_BINANCE_REST=https://fapi.binance.com
OPUS_BINANCE_CONNECT_TIMEOUT_S=15
OPUS_BINANCE_WS_OPEN_TIMEOUT_S=15

# Bybit (linear) endpoints. Read-only: used only for cross-exchange features.
OPUS_BYBIT_WS=wss://stream.bybit.com/v5/public/linear
OPUS_BYBIT_REST=https://api.bybit.com
OPUS_ENABLE_BYBIT=false

# ================================================================
# BINANCE API KEYS (only needed for LIVE mode)
# ================================================================
# Generate in Binance account, enable ONLY futures trading and whitelist your VPS IP.
# DO NOT enable withdrawals.
OPUS_BINANCE_API_KEY=
OPUS_BINANCE_API_SECRET=

# ================================================================
# SAFETY GUARDS (hard-coded limits, also configurable from UI)
# ================================================================
# Trading stops for the current UTC day when realised PnL <= -this_value (USD).
OPUS_DAILY_LOSS_LIMIT_USD=5.0

# Maximum notional position size per symbol (USD). UI cannot exceed this.
OPUS_MAX_POSITION_USD=50.0

# Maximum number of symbols trading live simultaneously.
OPUS_MAX_LIVE_SYMBOLS=1

# Maximum orders sent per minute (runaway protection).
OPUS_MAX_ORDERS_PER_MIN=60

# If Binance WebSocket has no message for this many milliseconds,
# cancel all orders and flatten (network kill switch).
OPUS_WS_STALE_MS=1500

# ================================================================
# ML / PAPER TRADER
# ================================================================
# Path to the trained model bundle. Output of `python -m backend.ml.train`.
# The directory must contain h{horizon}/{model.lgb,meta.json} sub-folders.
OPUS_MODEL_DIR=./models/global

# Which trained horizon to use for live predictions.
# Must match a folder name under OPUS_MODEL_DIR (e.g. "h1s", "h2s", "h15s").
# Defaults out-of-the-box: 1s / 5s / 30s.
# To train custom horizons run e.g.:
#     opus train --horizons 2s 5s 15s
OPUS_TRADE_HORIZON=5s

# Comma-separated list of symbols the paper trader is allowed to trade.
# Independent from the data-collection symbol set: you can collect on 9
# symbols but only trade 3 of them, or trade an entirely different set.
# These symbols MUST be in the UI subscription list (snapshot stream is
# what feeds the predictor).
# Empty = trade any symbol that is currently subscribed.
OPUS_TRADE_SYMBOLS=

# Minimum |confidence| (= |P(UP) - P(DOWN)|) required to open a trade.
# Range 0..1. Higher = fewer but higher-conviction trades.
# Typical sweep: 0.10 (lots of trades, lower edge) -> 0.50 (few, high edge).
OPUS_TRADE_CONF_THRESHOLD=0.10

# Notional size (USD) of every paper trade. PnL scales linearly so this only
# changes the dollar magnitude in the trade log, not the per-trade bp.
OPUS_TRADE_NOTIONAL_USD=10.0

# Round-trip taker fee (basis points/side). Binance Futures default = 4 bp/side.
# VIP1+ aggregated 30d volume = 3.5 bp; VIP3 = 1.6 bp; etc.
OPUS_TAKER_FEE_BP=4.0

# Maker fee (basis points/side). Binance Futures default = 2 bp; can be
# negative for VIP / rebated accounts.
OPUS_MAKER_FEE_BP=2.0

# Stop-loss in basis points (price moves against open position). Set high to disable.
OPUS_TRADE_STOP_LOSS_BP=50.0
